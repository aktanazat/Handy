<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Everything else is generated from INFOPLIST_KEY_* build settings. Background
	     modes are not among the keys Xcode's generator maps, and capture has to survive
	     the app leaving the foreground, so this one key is declared here. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
